# Copy to .env.local (never commit it). Both values are PUBLIC by design (they ship in the browser bundle);
# access is enforced by Row Level Security on the database, so never put a service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key
