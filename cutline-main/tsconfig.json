{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true, "jsx": "react-jsx",
    "jsxImportSource": "preact", "skipLibCheck": true, "noEmit": true,
    "types": ["vite/client", "node"], "isolatedModules": true, "noUnusedLocals": true
  },
  "include": ["src", "tests"]
}
