{
  "name": "Cutline",
  "short_name": "Cutline",
  "description": "Private, offline-first calorie and weight tracker. Your data stays on your device.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0E1A10",
  "theme_color": "#1B5E20",
  "categories": [
    "health",
    "fitness",
    "food"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Log food",
      "short_name": "Log food",
      "description": "Search and log a food",
      "url": "./#/log",
      "icons": [
        {
          "src": "icons/shortcut-log.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Weigh in",
      "short_name": "Weigh in",
      "description": "Record today's weight",
      "url": "./#/weight?add=1",
      "icons": [
        {
          "src": "icons/shortcut-weigh.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Scan barcode",
      "short_name": "Scan",
      "description": "Scan a product barcode",
      "url": "./#/log?mode=scan",
      "icons": [
        {
          "src": "icons/shortcut-scan.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
